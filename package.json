{
  "name": "product-blueprint",
  "version": "0.3.0",
  "description": "Adds the Product Engineering Blueprint to a repository: product and engineering documents, plus plain workflow instructions that agents follow on demand or as scheduled tasks to keep the documents and the code in line.",
  "keywords": [
    "ai-agents",
    "agents-md",
    "claude-code",
    "cursor",
    "github-copilot",
    "scaffold",
    "cli",
    "product-management",
    "documentation-drift",
    "scheduled-tasks"
  ],
  "license": "MIT",
  "author": "benvdbergh",
  "homepage": "https://github.com/benvdbergh/blueprint#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benvdbergh/blueprint.git"
  },
  "bugs": {
    "url": "https://github.com/benvdbergh/blueprint/issues"
  },
  "type": "module",
  "bin": {
    "blueprint": "bin/blueprint.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin/",
    "cli/",
    "AGENTS.md",
    "CLAUDE.md",
    ".claude/commands/",
    ".cursor/rules/",
    ".github/copilot-instructions.md",
    "blueprint/"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
