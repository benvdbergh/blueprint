{
  "$comment": "Single machine-readable source for governance rules. Read by scripts/governance/*.mjs and by AI workflows. Human explanation: governance/README.md.",
  "enforcement": "enforce",
  "documents": {
    "00": { "file": "blueprint/00-product-core.md", "title": "Product Core", "authority": "Product owner", "aiWorkflows": ["WF-01"], "alwaysProtected": true },
    "01": { "file": "blueprint/01-product.md", "title": "Product", "authority": "Product management", "aiWorkflows": ["WF-01", "WF-06"] },
    "02": { "file": "blueprint/02-ux-design.md", "title": "UX & Design", "authority": "UX / Product", "aiWorkflows": ["WF-02", "WF-06"] },
    "03": { "file": "blueprint/03-domain-data.md", "title": "Domain & Data", "authority": "Architecture", "aiWorkflows": ["WF-03", "WF-06"] },
    "04": { "file": "blueprint/04-architecture.md", "title": "Architecture & Technology", "authority": "Architecture", "aiWorkflows": ["WF-03", "WF-06"] },
    "05": { "file": "blueprint/05-interfaces.md", "title": "Interfaces & Integrations", "authority": "API / Engineering", "aiWorkflows": ["WF-04", "WF-06"] },
    "06": { "file": "blueprint/06-deployment.md", "title": "Deployment & Operations", "authority": "Engineering / Operations", "aiWorkflows": ["WF-03", "WF-06"] },
    "07": { "file": "blueprint/07-roadmap.md", "title": "Roadmap & Delivery", "authority": "Product management", "aiWorkflows": ["WF-01", "WF-06"] }
  },

  "protection": {
    "approvalLabel": "blueprint:approved-change",
    "protectedStatuses": ["approved"],
    "$comment": "A PR that changes a document whose BASE version has a protected status (or any alwaysProtected document) needs the approval label. Combine with CODEOWNERS + required reviews."
  },

  "impactRules": [
    { "name": "Database migrations", "workflow": "WF-03", "level": "require", "docs": ["03"],
      "paths": ["supabase/migrations/**", "migrations/**", "db/migrations/**", "prisma/schema.prisma", "drizzle/**"] },
    { "name": "Edge / serverless functions", "workflow": "WF-04", "level": "require", "docs": ["05"],
      "paths": ["supabase/functions/**", "api/**", "src/api/**", "server/**", "functions/**"] },
    { "name": "API contract", "workflow": "WF-04", "level": "require", "docs": ["05"],
      "paths": ["contracts/**"] },
    { "name": "Dependencies & tooling", "workflow": "WF-03", "level": "suggest", "docs": ["04"],
      "paths": ["package.json", "vite.config.*", "tsconfig*.json", "next.config.*"] },
    { "name": "Deployment & infrastructure", "workflow": "WF-03", "level": "suggest", "docs": ["06"],
      "paths": ["supabase/config.toml", "Dockerfile", "docker-compose*.yml", "vercel.json", "netlify.toml", "infra/**", ".github/workflows/deploy*"] },
    { "name": "Screens & routes", "workflow": "WF-02", "level": "suggest", "docs": ["01", "02"],
      "paths": ["src/pages/**", "src/routes/**", "src/app/**"] },
    { "name": "Components & design system", "workflow": "WF-02", "level": "suggest", "docs": ["02"],
      "paths": ["src/components/**", "tailwind.config.*", "src/index.css", "src/styles/**", "components.json"] },
    { "name": "Domain logic", "workflow": "WF-06", "level": "suggest", "docs": ["03"],
      "paths": ["src/domain/**", "src/lib/domain/**", "src/types/**"] }
  ],

  "traceability": {
    "testGlobs": ["tests/**", "test/**", "e2e/**", "**/*.test.*", "**/*.spec.*", "**/__tests__/**"],
    "ignoreGlobs": ["node_modules/**", "dist/**", "build/**", ".git/**", "coverage/**", "templates/**"],
    "coveredStatuses": ["approved", "in-progress", "implemented"],
    "enforceForStatuses": ["implemented"]
  },

  "terminology": {
    "scanGlobs": ["blueprint/**/*.md", "src/**/*.ts", "src/**/*.tsx"],
    "ignoreGlobs": ["blueprint/03-domain-data.md", "node_modules/**"]
  }
}
